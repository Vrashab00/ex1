# CloudPrune AI Environment Configuration

# Server Port
PORT=3001

# AI Intelligence Provider: 'auto' | 'gemini' | 'openai' | 'heuristic'
# 'auto': automatically selects Gemini if GEMINI_API_KEY is present, then OpenAI, else fallback to Heuristic
AI_PROVIDER=auto

# Google Gemini API Configuration (Official Google GenAI SDK)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Configuration (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# CORS Origin for Frontend
CORS_ORIGIN=http://localhost:5173

# Supabase Configuration (Server / Node.js)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Configuration (Client / Vite Frontend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
